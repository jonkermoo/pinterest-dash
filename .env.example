# Pinterest API Configuration
# Get these credentials from https://developers.pinterest.com/apps/

# Your Pinterest App ID
VITE_PINTEREST_APP_ID=your_app_id_here

# Your Pinterest App Secret (keep this secure!)
VITE_PINTEREST_APP_SECRET=your_app_secret_here

# OAuth Redirect URI (must match what you set in Pinterest Developer Console)
# For local development: http://localhost:5173/callback
# For production: https://yourdomain.com/callback
VITE_PINTEREST_REDIRECT_URI=http://localhost:5173/callback

# Pinterest API Base URL
VITE_PINTEREST_API_URL=https://api.pinterest.com/v5